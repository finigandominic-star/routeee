<div class="container mt-4">
  <div class="card shadow-sm border-0 rounded-4 bg-light">
    <div class="card-body p-4">

      <!-- Back Button -->
      <div class="mb-4">
        <%= link_to "← Back", itinerary_path(@chat.itinerary), class: "btn btn-sm border text-body border-success" %>
      </div>

      <!-- Map Container with Navigable Leaflet Controller -->
      <div
        data-controller="route-map"
        data-route-map-geojson-value="<%= @chat.itinerary.geojson.to_json if @chat.itinerary.geojson.present? %>"
        class="mb-4 shadow-sm rounded-3 border-success border-2"
        style="height: 350px; width: 100%; overflow: hidden;">
      </div>

      <!-- Messages Container -->
      <div id="messages" class="mb-4 overflow-y-auto" style="max-height: 400px; padding-right: 5px;">
        <% @chat.messages.each do |message| %>
          <% if message.role == "user" %>
            <div class="d-flex justify-content-end mb-3">
              <div class="px-3 pb-2 pt-3 rounded-3 shadow-sm bg-primary text-white" style="max-width: 80%;">
                <p class="created_at fst-italic small mb-1 opacity-75">
                  <%= message.created_at.strftime('%m/%d/%Y %H:%M %p') %>
                </p>
                <%= simple_format(message.content) %>
              </div>
            </div>
          <% elsif message.role == "assistant" %>
            <div class="d-flex justify-content-start mb-3">
              <div class="px-3 pb-2 pt-3 rounded-3 shadow-sm bg-white text-body border border-success" style="max-width: 80%;">
                <p class="created_at fst-italic small mb-1 opacity-75">
                  <%= message.created_at.strftime('%m/%d/%Y %H:%M %p') %>
                </p>
                <%= simple_format(message.content) %>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>

      <!-- Input Form -->
      <div id="new_message_container" class="mt-4 pt-3 border-top border-success" style="border-top-width: 1px !important;">
        <%= simple_form_for [@chat, @message] do |f| %>
          <div class="d-flex align-items-baseline gap-2">
            <%= f.input :content,
                        placeholder: "Where would you like to go for your bike trip?",
                        label: false,
                        required: true,
                        autofocus: true,
                        wrapper_html: {class: 'flex-grow-1 align-items-baseline', style: "height: 40px;" },
                        input_html: { class: 'form-control', style: "border-color: #A1CCA6;" } %>

            <button type="submit" class="btn btn-primary flex-shrink-1 rounded-3">
              Ask Routeee
            </button>
          </div>
        <% end %>
      </div>

    </div>
  </div>
</div>
