<div id="itinerary-details" class="card border-0 shadow-sm rounded-4 p-3 bg-white">
  <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
    <h5 class="mb-0 text-primary fw-bold">Route Details</h5>

    <!-- EDIT BUTTON Trigger -->
    <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#editRouteModal">
      <i class="bi bi-pencil me-1"></i> Edit Route
    </button>
  </div>

  <% if local_assigns[:saved] %>
    <div class="alert alert-success alert-dismissible fade show rounded-3 p-2 small mb-2" role="alert">
      <i class="bi bi-check-circle-fill me-1"></i> Changes saved!
      <button type="button" class="btn-close btn-close-xs" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% end %>

  <ul class="list-unstyled mt-2 mb-3">
    <li class="mb-2"><strong>Bike Type:</strong> <%= itinerary.bike_type&.gsub('cycling-', '')&.capitalize || "-" %></li>
    <li class="mb-2"><strong>Distance:</strong> <%= itinerary.distance || "?" %> miles</li>
    <li class="mb-2"><strong>Start:</strong> <%= itinerary.start_destination || "-" %></li>
    <li class="mb-2"><strong>End:</strong> <%= itinerary.end_destination || "-" %></li>
    <li class="mb-2"><strong>Group Size:</strong> <%= itinerary.group_size || "-" %></li>
    <li class="mb-2"><strong>Kids:</strong> <%= itinerary.kids&.capitalize || "-" %></li>
  </ul>

  <!-- SAVE ITINERARY FORM -->
  <%= form_with model: itinerary, method: :patch, data: { turbo: true } do |f| %>
    <%= f.hidden_field :start_destination, value: itinerary.start_destination %>
    <%= f.hidden_field :end_destination, value: itinerary.end_destination %>
    <%= f.hidden_field :bike_type, value: itinerary.bike_type %>
    <%= f.hidden_field :distance, value: itinerary.distance %>
    <%= f.hidden_field :group_size, value: itinerary.group_size %>
    <%= f.hidden_field :kids, value: itinerary.kids %>

    <button type="submit" class="btn btn-success rounded-pill w-100 shadow-sm fw-bold">
      <i class="bi bi-check-circle me-1"></i> Save Changes
    </button>
  <% end %>
</div>
