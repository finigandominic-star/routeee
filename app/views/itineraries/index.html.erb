<div class="container py-5">

  <!-- Header Section -->
  <div class="d-flex justify-content-between align-items-center mb-5 pb-3 border-bottom" style="border-color: rgba(13, 148, 136, 0.15) !important;">
    <div>
      <p class="text-uppercase fw-bold small mb-1" style="letter-spacing: 0.08em; color: var(--teal);">Routeee</p>
      <h1 class="display-6 fw-bold text-body mb-1">My routes</h1>
      <p class="text-muted mb-0">Manage and edit your planned cycling itineraries</p>
    </div>

    <%= button_to "Plan a new route", itineraries_path, method: :post, class: "btn btn-teal btn-lg rounded-pill px-4 shadow-sm fw-semibold" %>
  </div>

  <!-- Grid Section for Saved Itineraries -->
  <% if @itineraries.present? && @itineraries.any? %>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-5">
      <% @itineraries.each do |itinerary| %>
        <div class="col">
          <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden route-card">

        <!-- Map Preview & Badges -->
        <div class="position-relative" style="height: 180px; width: 100%;">
        <% if itinerary.geojson.present? %>
        <div
          id="map-<%= itinerary.id %>"
          data-controller="route-map"
          data-route-map-interactive-value="false"
          data-route-map-geojson-value="<%= itinerary.geojson.is_a?(String) ? itinerary.geojson : itinerary.geojson.to_json %>"
          style="height: 100%; width: 100%;">
        </div>
        <% else %>
         <div class="d-flex flex-column align-items-center justify-content-center h-100" style="background: linear-gradient(135deg, #e6f7f5 0%, #f4faf9 100%); color: var(--teal);">
        <i class="bi bi-signpost-split fs-2 mb-2 opacity-50"></i>
        <span class="small fw-semibold opacity-75">No route generated yet</span>
        </div>
      <% end %>

              <!-- Badges -->
              <div class="position-absolute top-0 end-0 m-3 d-flex gap-2">
                <span class="badge bg-white border-0 shadow-sm rounded-pill px-3 py-2 small fw-semibold" style="color: var(--teal);">
                  <i class="bi bi-bicycle me-1"></i>
                  <%= itinerary.bike_type&.gsub('cycling-', '')&.capitalize || "Regular" %>
                </span>
                <% if itinerary.distance.present? %>
                  <span class="badge text-white shadow-sm rounded-pill px-3 py-2 small fw-semibold" style="background: var(--teal);">
                    <%= itinerary.distance %> mi
                  </span>
                <% end %>
              </div>
            </div>

            <!-- Card Body -->
            <div class="card-body p-4 d-flex flex-column">
              <h5 class="card-title fw-bold text-body mb-3 d-flex align-items-center gap-2">
                <span class="text-truncate">
                  <%= itinerary.start_destination.presence || "New route plan" %>
                </span>
                <% if itinerary.end_destination.present? %>
                  <i class="bi bi-arrow-right flex-shrink-0" style="color: var(--teal);"></i>
                  <span class="text-truncate">
                    <%= itinerary.end_destination %>
                  </span>
                <% end %>
              </h5>

              <!-- Metadata -->
              <div class="rounded-3 p-3 mb-3" style="background: #f3faf9;">
                <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom small" style="border-color: rgba(13, 148, 136, 0.12) !important;">
                  <span class="text-muted fw-semibold"><i class="bi bi-people me-2" style="color: var(--teal);"></i>Group size</span>
                  <span class="fw-bold text-body"><%= itinerary.group_size || "—" %></span>
                </div>
                <div class="d-flex justify-content-between align-items-center small">
                  <span class="text-muted fw-semibold"><i class="bi bi-emoji-smile me-2" style="color: var(--teal);"></i>Kids friendly</span>
                  <span class="fw-bold text-body"><%= itinerary.kids&.capitalize || "—" %></span>
                </div>
              </div>

              <!-- System Prompt -->
              <% if itinerary.system_prompt.present? %>
                <p class="card-text text-muted small text-truncate mb-4" title="<%= itinerary.system_prompt %>">
                  <i class="bi bi-quote me-1"></i><%= itinerary.system_prompt %>
                </p>
              <% end %>

              <!-- Action Buttons -->
              <div class="d-flex gap-2 mt-auto">
                <%= link_to itinerary_path(itinerary), class: "btn btn-outline-teal btn-sm rounded-pill w-100 fw-semibold" do %>
                  <i class="bi bi-eye me-1"></i>View details
                <% end %>

                <%= button_to itinerary_path(itinerary), method: :delete,
                    data: { turbo_confirm: "Are you sure you want to delete this itinerary?" },
                    class: "btn btn-outline-danger btn-sm rounded-pill w-100 fw-semibold" do %>
                  <i class="bi bi-trash me-1"></i>Delete
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>

  <!-- Empty State -->
  <% else %>
    <div class="text-center py-5 my-5">
      <i class="bi bi-signpost-split display-3 opacity-25 mb-3 d-block" style="color: var(--teal);"></i>
      <h4 class="fw-bold text-body mb-2">No routes yet</h4>
      <p class="text-muted mb-4">Start planning your first cycling itinerary with Routeee.</p>
      <%= button_to "Plan a new route", itineraries_path, method: :post, class: "btn btn-teal rounded-pill px-4 shadow-sm fw-semibold" %>
    </div>
  <% end %>
</div>

<style>
  :root {
    --teal: #23CED9;
    --teal-dark: #1AA8B2;
  }

  .route-card {
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .route-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(13, 148, 136, 0.14) !important;
  }

  .btn-teal {
    background-color: var(--teal);
    border-color: var(--teal);
    color: #fff;
  }
  .btn-teal:hover, .btn-teal:focus {
    background-color: var(--teal-dark);
    border-color: var(--teal-dark);
    color: #fff;
  }

  .btn-outline-teal {
    background-color: transparent;
    border: 1px solid var(--teal);
    color: var(--teal);
  }
  .btn-outline-teal:hover, .btn-outline-teal:focus {
    background-color: var(--teal);
    border-color: var(--teal);
    color: #fff;
  }
</style>
