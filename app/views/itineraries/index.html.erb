<!-- Action Buttons in app/views/itineraries/index.html.erb -->
<div class="card-footer bg-white border-top-0 pt-0 d-flex gap-2">
  <%# Find or link to existing chat for this itinerary %>
  <% chat = itinerary.chats.find_by(user: current_user) %>
  <% if chat %>
    <%= link_to "Edit with AI", chat_path(chat), class: "btn btn-outline-primary btn-sm w-100" %>
  <% else %>
    <%= link_to "View Details", itinerary_path(itinerary), class: "btn btn-outline-primary btn-sm w-100" %>
  <% end %>

  <%= button_to "Delete", itinerary_path(itinerary), method: :delete,
      data: { turbo_confirm: "Are you sure you want to delete this itinerary?" },
      class: "btn btn-outline-danger btn-sm w-100" %>
</div>
