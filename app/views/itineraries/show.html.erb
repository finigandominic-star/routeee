<div class="container m-5">
  <h1><%= @itinerary.name %></h1>

  <div class="row">
    <!-- REMOVED the .each loop entirely. @itinerary is just one item! -->
    <div class="col-12 col-md-6 mb-3"> <!-- Made it wider since it's just one card -->
      <div class="card h-100 shadow-sm border-0">
        <div class="card-body">
          <h5 class="card-title text-primary"><%= @itinerary.name %></h5>
          <ul class="list-unstyled mt-3">
            <li class="mb-2"><strong>Bike Type:</strong> <%= @itinerary.bike_type %></li>
            <li class="mb-2"><strong>Distance:</strong> <%= @itinerary.distance %></li>
            <li class="mb-2"><strong>Start:</strong> <%= @itinerary.start_destination %></li>
            <li class="mb-2"><strong>End:</strong> <%= @itinerary.end_destination %></li>
            <li class="mb-2"><strong>Group Size:</strong> <%= @itinerary.group_size %></li>
            <li class="mb-2"><strong>Kids:</strong> <%= @itinerary.kids %></li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <%= link_to "Back to itineraries", root_path, class: "btn btn-outline-secondary mt-3 mb-5" %>

  <!-- Header Section with Title and Button -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0">Chats</h4>
    <%= link_to "New Chat", new_itinerary_chat_path(@itinerary), class: "btn btn-primary btn-sm" %>
  </div>

  <!-- Bootstrap Accordion -->
  <div class="accordion shadow-sm" id="chatsAccordion">
    <% if @itinerary.chats.any? %>
      <% @itinerary.chats.each_with_index do |chat, index| %>
        <div class="accordion-item border-0 border-bottom">

          <!-- Accordion Header (Clickable) -->
          <!-- FIXED: id uses chat.id exclusively to avoid broken HTML formatting -->
          <h2 class="accordion-header" id="heading-<%= chat.id %>">
            <button class="accordion-button <%= 'collapsed' unless index == 0 %> bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-<%= chat.id %>" aria-expanded="<%= index == 0 ? 'true' : 'false' %>" aria-controls="collapse-<%= chat.id %>">
              <strong>Chat: <%= chat.title %></strong> &nbsp;<span class="text-muted small">— Started <%= time_ago_in_words(chat.created_at) %> ago</span>
            </button>
          </h2>

          <!-- Accordion Body (Expandable Details) -->
          <!-- FIXED: id="collapse-<%= chat.id %>" (was chat.title) -->
          <div id="collapse-<%= chat.id %>" class="accordion-collapse collapse <%= 'show' if index == 0 %>" aria-labelledby="heading-<%= chat.id %>" data-bs-parent="#chatsAccordion">
            <div class="accordion-body">

              <!-- Render the messages for this chat -->
              <% if chat.messages.any? %>
                <div class="d-flex flex-column gap-2">
                  <% chat.messages.each do |message| %>
                    <div class="p-2 rounded <%= message.role == 'user' ? 'bg-primary text-white align-self-end' : 'bg-light align-self-start' %>" style="max-width: 80%;">
                      <strong><%= message.role.capitalize %>:</strong> <%= message.content %>
                    </div>
                  <% end %>
                </div>
              <% else %>
                <p class="text-muted mb-0">No messages yet.</p>
              <% end %>

            </div>
          </div>

        </div>
      <% end %>
    <% else %>
      <div class="alert alert-light text-center text-muted mb-0 border">
        No chats started yet.
      </div>
    <% end %>
  </div>
</div>

<%# version3 from the slides %>
<div class="row">
  <div class="col">
    <h1><%= @itinerary.name %></h1>
    <%= raw(render_markdown(@itinerary.name)) %>
  </div>
  <div class="col-md-3">
    <h2>Chats</h2>
    <div class="mb-4">
      <% if @chats.any? %>
        <ul>
          <% @chats.each do |chat| %>
            <li><%= link_to chat.title, chat_path(chat) %></li>
          <% end %>
        </ul>
      <% else %>
        There are no chats yet.
      <% end %>
      <%= button_to "New chat", itinerary_chats_path(@itinerary), class: "btn btn-primary" %>
    </div>
  </div>
</div>
