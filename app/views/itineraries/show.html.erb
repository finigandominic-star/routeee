<div class="container py-5">

  <!-- Page Header & Navigation -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="display-5 fw-bold text-dark mb-0"><%= @itinerary.name || "Route Planner" %></h1>
    <%= link_to "← Back to Itineraries", itineraries_path, class: "btn btn-outline-secondary rounded-pill px-4 fw-semibold" %>
    <%= button_to "Delete Itinerary", itinerary_path(@itinerary),
    method: :delete,
    class: "btn btn-sm btn-outline-danger rounded-pill px-3",
    data: { turbo_confirm: "Are you sure you want to delete this route?" } %>

  </div>

  <div class="row mb-5 g-4">

    <!-- Left Column: Details -->
    <div class="col-12 col-md-5">
      <div class="card h-100 shadow-sm border-0 rounded-4">
        <div class="card-body p-4">
          <h5 class="fw-bold text-primary mb-4">Route Details</h5>

          <div id="itinerary-details">
            <ul class="list-group list-group-flush">
              <li class="list-group-item d-flex justify-content-between align-items-center px-0 border-bottom bg-transparent py-3">
                <span class="text-muted fw-semibold">Bike Type</span>
                <span class="fw-bold text-dark"><%= @itinerary.bike_type&.gsub('cycling-', '')&.capitalize || "Pending..." %></span>
              </li>
              <li class="list-group-item d-flex justify-content-between align-items-center px-0 border-bottom bg-transparent py-3">
                <span class="text-muted fw-semibold">Distance</span>
                <span class="fw-bold text-dark"><%= @itinerary.distance ? "#{@itinerary.distance} miles" : "Pending..." %></span>
              </li>
              <li class="list-group-item d-flex justify-content-between align-items-center px-0 border-bottom bg-transparent py-3">
                <span class="text-muted fw-semibold">Start</span>
                <span class="fw-bold text-dark text-end ms-3"><%= @itinerary.start_destination || "Pending..." %></span>
              </li>
              <li class="list-group-item d-flex justify-content-between align-items-center px-0 border-bottom bg-transparent py-3">
                <span class="text-muted fw-semibold">End</span>
                <span class="fw-bold text-dark text-end ms-3"><%= @itinerary.end_destination || "Pending..." %></span>
              </li>
              <li class="list-group-item d-flex justify-content-between align-items-center px-0 border-bottom bg-transparent py-3">
                <span class="text-muted fw-semibold">Group Size</span>
                <span class="fw-bold text-dark"><%= @itinerary.group_size || "-" %></span>
              </li>
              <li class="list-group-item d-flex justify-content-between align-items-center px-0 bg-transparent py-3">
                <span class="text-muted fw-semibold">Kids</span>
                <span class="fw-bold text-dark"><%= @itinerary.kids&.capitalize || "-" %></span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: The Map -->
    <div class="col-12 col-md-7">
      <div id="itinerary-map" class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden">
        <% if @itinerary.geojson.present? %>
          <div
            data-controller="route-map"
            data-route-map-geojson-value="<%= @itinerary.geojson.to_json %>"
            style="height: 100%; min-height: 400px; width: 100%;">
          </div>
        <% else %>
          <div class="bg-light d-flex align-items-center justify-content-center text-muted" style="height: 100%; min-height: 400px; width: 100%;">
            <div class="text-center p-4">
              <h5 class="fw-bold text-secondary">No route generated yet</h5>
              <p class="mb-0">Chat with the assistant below to plot it!</p>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Header Section with Title and Button -->
  <div class="d-flex justify-content-between align-items-center mt-5 mb-4">
    <h4 class="fw-bold mb-0 text-dark">Assistant Chats</h4>
    <%= button_to "+ New Chat", itinerary_chats_path(@itinerary), class: "btn btn-outline-primary rounded-pill px-3 fw-semibold shadow-sm", method: :post %>
  </div>

  <!-- Bootstrap Accordion -->
  <div class="accordion shadow-sm rounded-4 overflow-hidden border-0" id="chatsAccordion">

    <% if @itinerary.chats.any? %>
      <% @itinerary.chats.each_with_index do |chat, index| %>
        <div class="accordion-item border-0 border-bottom">

          <h2 class="accordion-header" id="heading-<%= chat.id %>">
            <button class="accordion-button bg-light fw-semibold text-dark <%= 'collapsed' unless index == 0 %>" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-<%= chat.id %>" aria-expanded="<%= index == 0 ? 'true' : 'false' %>" aria-controls="collapse-<%= chat.id %>">
              <%= chat.title.presence || "Chat #{chat.id}" %> &nbsp;<span class="text-muted fw-normal fs-6">| <%= chat.created_at.strftime("%b %d, %Y") %></span>
            </button>
          </h2>

          <div id="collapse-<%= chat.id %>" class="accordion-collapse collapse <%= 'show' if index == 0 %>" aria-labelledby="heading-<%= chat.id %>" data-bs-parent="#chatsAccordion">
            <div class="accordion-body p-4">

              <!-- Chat Action Buttons -->
              <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                <!-- Renamed from 'Continue Chat' to 'Edit' while linking to existing chat -->
                <% if @itinerary.chats.present? %>
                  <%= link_to "Edit Route", chat_path(@itinerary.chats.last), class: "btn btn-primary rounded-pill px-3" %>
                  <% else %>
                    <button class="btn btn-secondary" disabled>Chat Deleted</button>
                <% end %>

                <%= button_to "Delete Chat", itinerary_chat_path(@itinerary, chat),
                    method: :delete,
                    data: { turbo_confirm: "Are you sure you want to delete this chat?" },
                    class: "btn btn-sm btn-outline-danger rounded-pill px-3" %>
              </div>

              <!-- Chat Messages Preview -->
              <% if chat.messages.any? %>
                <div class="d-flex flex-column gap-3">
                  <% chat.messages.each do |message| %>
                    <div class="p-3 rounded-4 shadow-sm <%= message.role == 'user' ? 'bg-primary text-white align-self-end' : 'bg-white border align-self-start' %>" style="max-width: 80%;">
                      <p class="created_at fst-italic small mb-1 opacity-75">
                        <%= message.created_at.strftime('%m/%d/%Y %H:%M %p') %>
                      </p>
                      <strong><%= message.role.capitalize %>:</strong> <%= simple_format(message.content) %>
                    </div>
                  <% end %>
                </div>
              <% else %>
                <p class="text-muted text-center mb-0 py-3">No messages yet. Click 'Edit' to start.</p>
              <% end %>

            </div>
          </div>
        </div>
      <% end %>

    <% else %>
      <div class="alert alert-light text-center text-muted mb-0 py-5 rounded-4 shadow-sm border-0">
        <p class="mb-0 fw-semibold fs-5">No chats started yet.</p>
        <p class="small">Use the button above to begin planning this route.</p>
      </div>
    <% end %>

  </div>
</div>
