<!-- Header Section with Title and Button -->
<div class="d-flex justify-content-between align-items-center mb-4">
  <h4 class="mb-0">Chats</h4>
  <!-- Adjust the path below to match your actual routes (e.g., new_chat_path) -->
  <%= link_to "New Chat", new_itinerary_chat_path(@itinerary), class: "btn btn-primary btn-sm" %>
</div>

<!-- Bootstrap Accordion -->
<div class="accordion shadow-sm" id="chatsAccordion">
  <% if @itinerary.chats.any? %>
    <% @itinerary.chats.each_with_index do |chat, index| %>
      <div class="accordion-item border-0 border-bottom">

        <!-- Accordion Header (Clickable) -->
        <h2 class="accordion-header" id="heading-<%= chat.title %>">
          <!-- The 'collapsed' class and aria-expanded control the initial open/closed state -->
          <button class="accordion-button <%= 'collapsed' unless index == 0 %> bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-<%= chat.id %>" aria-expanded="<%= index == 0 ? 'true' : 'false' %>" aria-controls="collapse-<%= chat.id %>">
            <strong>Chat: <%= chat.title %></strong> &nbsp;<span class="text-muted small">— Started <%= time_ago_in_words(chat.created_at) %> ago</span>
          </button>
        </h2>

        <!-- Accordion Body (Expandable Details) -->
        <div id="collapse-<%= chat.title %>" class="accordion-collapse collapse <%= 'show' if index == 0 %>" aria-labelledby="heading-<%= chat.id %>" data-bs-parent="#chatsAccordion">
          <div class="accordion-body">

            <!-- Render the messages for this chat -->
            <% if chat.messages.any? %>
              <div class="d-flex flex-column gap-2">
                <% chat.messages.each do |message| %>
                  <div class="p-2 rounded <%= message.role == 'user' ? 'bg-primary text-white align-self-end' : 'bg-light align-self-start' %>" style="max-width: 80%;">
                    <strong><%= message.role.capitalize %>:</strong> <%= message.content %>
                  </div>
                <% end %>
              </div>
            <% else %>
              <p class="text-muted mb-0">No messages yet.</p>
            <% end %>

          </div>
        </div>

      </div>
    <% end %>
  <% else %>
    <div class="alert alert-light text-center text-muted mb-0">
      No chats started yet.
    </div>
  <% end %>
</div>
