<%# app/views/devise/registrations/new.html.erb %>

<div class="d-flex justify-content-center align-items-center" style="min-height: 90vh;">
  <div class="card border-0 routeee-card" style="width: 100%; max-width: 400px;">
    <div class="card-body p-5">

      <!-- Header -->
      <div class="text-center mb-4">
        <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary bg-opacity-10 mb-3" style="width: 56px; height: 56px;">
          <i class="bi bi-signpost-split fs-4 text-primary"></i>
        </div>
        <p class="text-uppercase fw-bold small text-primary mb-1" style="letter-spacing: 0.08em;">Routeee</p>
        <h2 class="h4 fw-bold mb-1">Create your account</h2>
        <p class="text-muted small mb-0">Start planning your rides</p>
      </div>

      <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div class="form-inputs">
          <%= f.input :email,
                      required: false,
                      autofocus: true,
                      label: "Email",
                      input_html: { autocomplete: "email", placeholder: "you@example.com", class: "routeee-input" },
                      wrapper_html: { class: "mb-3" } %>

          <%= f.input :password,
                      required: false,
                      label: "Password",
                      hint: (@minimum_password_length ? "#{@minimum_password_length} characters minimum" : nil),
                      input_html: { autocomplete: "new-password", placeholder: "••••••••", class: "routeee-input" },
                      wrapper_html: { class: "mb-3" } %>

          <%= f.input :password_confirmation,
                      required: false,
                      label: "Confirm password",
                      input_html: { autocomplete: "new-password", placeholder: "••••••••", class: "routeee-input" },
                      wrapper_html: { class: "mb-4" } %>
        </div>

        <div class="form-actions">
          <%= f.button :submit, "Sign up", class: "btn btn-primary w-100 fw-semibold py-2" %>
        </div>
      <% end %>

      <div class="text-center mt-4 pt-3 border-top">
        <div class="small">
          <%= render "devise/shared/links" %>
        </div>
      </div>

    </div>
  </div>
</div>

<style>
  .routeee-card {
    box-shadow: 0 10px 30px rgba(35, 206, 217, 0.18);
  }

  .routeee-input {
    color: var(--bs-primary) !important;
    background-color: #fff !important;
  }
  .routeee-input:focus {
    color: var(--bs-primary) !important;
    background-color: #fff !important;
    box-shadow: 0 0 0 0.2rem rgba(35, 206, 217, 0.15);
  }

  /* Neutralize the browser's yellow autofill tint (Chrome/Safari) */
  .routeee-input:-webkit-autofill,
  .routeee-input:-webkit-autofill:hover,
  .routeee-input:-webkit-autofill:focus {
    -webkit-text-fill-color: var(--bs-primary) !important;
    -webkit-box-shadow: 0 0 0px 1000px #fff inset !important;
    box-shadow: 0 0 0px 1000px #fff inset !important;
    transition: background-color 9999s ease-in-out 0s;
  }
</style>
