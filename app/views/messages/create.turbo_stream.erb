<%# 1. Clear input field %>
<%= turbo_stream.replace "new_message_container" do %>
  <div id="new_message_container" class="mt-4 pt-3 border-top border-success" style="border-top-width: 1px !important;">
    <%= simple_form_for [@chat, Message.new] do |f| %>
      <div class="input-group">
        <%= f.input :content,
                    label: false,
                    required: true,
                    placeholder: "How should I get started with the bike trip?",
                    wrapper_html: { class: 'flex-grow-1' },
                    input_html: { class: 'form-control', style: "border-color: #A1CCA6;" } %>

        <button type="submit" class="btn btn-primary rounded-end-3">
          Ask LLM
        </button>
      </div>
    <% end %>
  </div>
<% end %>

<%# 2. Append User Message %>
<%= turbo_stream.append "messages" do %>
  <div class="d-flex justify-content-end mb-3">
    <div class="px-3 pb-2 pt-3 rounded-3 shadow-sm bg-primary text-white" style="max-width: 80%;">
      <p class="created_at fst-italic small mb-1 opacity-75">
        <%= @message.created_at.strftime('%m/%d/%Y %H:%M %p') %>
      </p>
      <%= simple_format(@message.content) %>
    </div>
  </div>
<% end %>

<%# 3. Append Assistant Message %>
<%= turbo_stream.append "messages" do %>
  <div class="d-flex justify-content-start mb-3">
    <div class="px-3 pb-2 pt-3 rounded-3 shadow-sm bg-white text-body border border-success" style="max-width: 80%;">
      <p class="created_at fst-italic small mb-1 opacity-75">
        <%= @assistant_message.created_at.strftime('%m/%d/%Y %H:%M %p') %>
      </p>
      <%= simple_format(@assistant_message.content) %>
    </div>
  </div>
<% end %>

<%# 4. Update Map & Details if new GeoJSON was returned %>
<% if @geojson.present? %>
  <%= turbo_stream.replace "itinerary-map" do %>
    <div id="itinerary-map" class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden">
      <div
        data-controller="route-map"
        data-route-map-geojson-value="<%= @geojson.to_json %>"
        style="height: 100%; min-height: 350px; width: 100%;">
      </div>
    </div>
  <% end %>

  <%= turbo_stream.replace "itinerary-details" do %>
    <div id="itinerary-details">
      <ul class="list-group list-group-flush">
        <li class="list-group-item d-flex justify-content-between align-items-center px-0 border-bottom bg-transparent py-3">
          <span class="text-muted fw-semibold">Bike Type</span>
          <span class="fw-bold text-dark"><%= @chat.itinerary.bike_type&.gsub('cycling-', '')&.capitalize %></span>
        </li>
        <li class="list-group-item d-flex justify-content-between align-items-center px-0 border-bottom bg-transparent py-3">
          <span class="text-muted fw-semibold">Distance</span>
          <span class="fw-bold text-dark"><%= @chat.itinerary.distance %> miles</span>
        </li>
        <li class="list-group-item d-flex justify-content-between align-items-center px-0 border-bottom bg-transparent py-3">
          <span class="text-muted fw-semibold">Start</span>
          <span class="fw-bold text-dark text-end ms-3"><%= @chat.itinerary.start_destination %></span>
        </li>
        <li class="list-group-item d-flex justify-content-between align-items-center px-0 border-bottom bg-transparent py-3">
          <span class="text-muted fw-semibold">End</span>
          <span class="fw-bold text-dark text-end ms-3"><%= @chat.itinerary.end_destination %></span>
        </li>
        <li class="list-group-item d-flex justify-content-between align-items-center px-0 border-bottom bg-transparent py-3">
          <span class="text-muted fw-semibold">Group Size</span>
          <span class="fw-bold text-dark"><%= @chat.itinerary.group_size || "-" %></span>
        </li>
        <li class="list-group-item d-flex justify-content-between align-items-center px-0 bg-transparent py-3">
          <span class="text-muted fw-semibold">Kids</span>
          <span class="fw-bold text-dark"><%= @chat.itinerary.kids&.capitalize || "-" %></span>
        </li>
      </ul>
    </div>
  <% end %>
<% end %>
